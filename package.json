{
  "displayName": "Homebridge Virtual Button",
  "name": "homebridge-virtual-button",
  "type": "module",
  "version": "1.5.0",
  "description": "Just simple virtual buttons accessories for Homebridge",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rocket-monkey/homebridge-virtual-button.git"
  },
  "bugs": {
    "url": "https://github.com/rocket-monkey/homebridge-virtual-button/issues"
  },
  "engines": {
    "node": "^18.20.4 || ^20.12.2 || ^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
